# Web3Forms inbox that enquiry submissions are delivered to.
# Optional: src/config.ts falls back to the production key when this is unset.
# Public by design (the value is rendered into the page HTML).
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave blank to ship no analytics: no gtag script, no cookies, and the Privacy
# Policy + cookie banner automatically describe a tracking-free site. Setting it
# enables all three together.
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (the "HTML tag" method — paste only
# the content value, not the whole <meta> tag). Not needed if you verified the
# domain by DNS TXT record instead.
PUBLIC_GSC_VERIFICATION=
